# Server configuration
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Email (Resend SMTP)
# Resend: resend.com da API key oling (bepul 100 email/kun).
#   SMTP login: resend, parol: API key
#   Free rejimda faqat tasdiqlangan emailingizga yubora olasiz
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key

# File uploads (local storage via Multer)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Stripe (test mode)
# https://dashboard.stripe.com/test/apikeys dan olinadi
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
